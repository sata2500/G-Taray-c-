{
  "manifest_version": 2,
  "name": "G-Tarayıcı Yardımcısı",
  "version": "2.9.0",
  "description": "Arka planda oynatma, medya kontrolleri, video konumu (resim içinde resim), SponsorBlock sayfadaki indirilebilir öğelerin taranması veri tasarrufu başlığı ve yalnızca gizli sekmelerde VPN.",
  "browser_specific_settings": {
    "gecko": {
      "id": "helper@gtarayici.app"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "declarativeNetRequest",
    "proxy",
    "<all_urls>",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "resources.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
