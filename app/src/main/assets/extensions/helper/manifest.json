{
  "manifest_version": 2,
  "name": "G-Tarayıcı Yardımcısı",
  "version": "1.4.0",
  "description": "Arka planda oynatma, resim içinde resim, medya kontrolleri ve SponsorBlock desteği.",
  "browser_specific_settings": {
    "gecko": { "id": "helper@gtarayici.app" }
  },
  "permissions": [
    "nativeMessaging",
    "<all_urls>",
    "https://sponsor.ajay.app/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["media.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
