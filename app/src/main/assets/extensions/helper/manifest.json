{
  "manifest_version": 2,
  "name": "G-Tarayıcı Yardımcısı",
  "version": "1.0.0",
  "description": "YouTube arka planda oynatma ve SponsorBlock desteği.",
  "browser_specific_settings": {
    "gecko": { "id": "helper@gtarayici.app" }
  },
  "permissions": [
    "nativeMessaging",
    "https://sponsor.ajay.app/*",
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
